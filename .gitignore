# Virtual environment
.venv/
venv/

# Python bytecode
**/__pycache__/
*.pyc
*.pyo

# Package build artifacts
*.egg-info/

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Training runs -- checkpoints and plots, regenerated by scripts/train.py
runs/

# Pretrained backbones downloaded by Ultralytics at train time
/yolo*.pt

# Trained model weights ARE tracked, as plain files (not Git LFS) so that
# `pip install git+...` ships the real weights instead of LFS pointer files.
# The blanket *.pt ignore that used to live here silently defeated that,
# which is why no teammate could reproduce a result from a shared checkout.
*.pt
!src/urolens_ai/models/**/*.pt

# Images -- except the committed test fixtures
*.jpg
*.png
!tests/fixtures/sample_images/*.jpg
!tests/fixtures/sample_images/*.png

# Environment -- may contain credentials
.env
